# ===== EDIT THESE =====
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
# owner/name of the GitHub repo that runs the workflows (only 0b_pipeline_identity uses it)
GITHUB_REPO=<owner>/<repo>

# ===== DEFAULTS (every Azure name is built from these) =====
AZURE_LOCATION=eastus
REGION_CODE=eus
WORKLOAD=hamulti
AGENT_NAME=frankies-bakery-support

# ===== LOCAL RUN OF THE AGENT CODE (python agent/main.py). The platform injects both in the cloud. =====
FOUNDRY_PROJECT_ENDPOINT=https://msf-ais-eus-hamulti-dev.services.ai.azure.com/api/projects/prj-ais-eus-hamulti-dev
AZURE_AI_MODEL_DEPLOYMENT_NAME=chat-model
